APP_NAME=OldiGoldi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://oldigoldi.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=oldigoldi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,oldigoldi.test

# Payment Gateway - DOKU (sandbox)
# Docs: https://developers.doku.com/accept-payments/doku-checkout
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_NOTIFICATION_URL=
DOKU_RETURN_URL=
DOKU_CALLBACK_URL=
PAYMENT_CURRENCY=IDR
PAYMENT_EXPIRY_MINUTES=60
PAYMENT_SANDBOX=true

# Legacy aliases (kept for backward compat)
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Tracking Service - Biteship (sandbox)
# Docs: https://biteship.com/en/docs
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_WEBHOOK_HEADER=X-Biteship-Signature
BITESHIP_WEBHOOK_SECRET=
BITESHIP_ORIGIN_CONTACT_NAME=
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_CONTACT_EMAIL=
BITESHIP_ORIGIN_ORGANIZATION=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_ORIGIN_POSTAL_CODE=
BITESHIP_ORIGIN_LATITUDE=
BITESHIP_ORIGIN_LONGITUDE=
BITESHIP_DEFAULT_WEIGHT=200
BITESHIP_DEFAULT_LENGTH=10
BITESHIP_DEFAULT_WIDTH=10
BITESHIP_DEFAULT_HEIGHT=10
TRACKING_SANDBOX=true

# Legacy aliases (kept for backward compat)
TRACKING_API_URL=
TRACKING_API_KEY=
TRACKING_API_SECRET=
TRACKING_WEBHOOK_SECRET=
